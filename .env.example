# Copy to .env and fill in. Never commit .env.

# "development" locally, "production" when deployed
APP_ENV=development
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# Public URL used for canonical/OG/sitemap, e.g. https://sumitkanchole.onrender.com
SITE_URL=
# true on Render/Heroku/behind Nginx
TRUST_PROXY=false

# SQLite file (relative paths live in instance/)
DATABASE=messages.sqlite3
# Contact form: N submissions per window (seconds) per IP
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW=600

# Optional: email me when someone uses the contact form (e.g. Gmail + App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=kancholesumit@gmail.com
